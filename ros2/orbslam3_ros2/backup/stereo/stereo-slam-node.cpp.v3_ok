#include "stereo-slam-node.hpp"

#include <algorithm>
#include <cmath>
#include <cstddef>
#include <cstdint>
#include <functional>
#include <iomanip>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <unordered_set>
#include <vector>

#include <Eigen/Geometry>

#include <opencv2/core/core.hpp>
#include <opencv2/calib3d.hpp>
#include <opencv2/imgproc.hpp>

#include "sensor_msgs/point_cloud2_iterator.hpp"


using std::placeholders::_1;
using std::placeholders::_2;


namespace
{

/*
 * ORB-SLAM3世界坐标系。
 */
constexpr const char* kOrbMapFrame =
    "orb_map";


/*
 * Path约10 Hz。
 */
constexpr std::uint32_t kPathPublishStride =
    3;


/*
 * Path最大长度。
 */
constexpr std::size_t kMaxPathPoses =
    2000;


/*
 * RViz MapPoints约2 Hz。
 */
constexpr std::uint32_t kMapPointsPublishStride =
    15;


/*
 * RViz每次最多发布300点。
 */
constexpr std::size_t kMaxPublishedMapPoints =
    300;


/*
 * ==========================================================
 * MapPoint同步 V3
 * ==========================================================
 */


/*
 * 一个Batch最多20条操作。
 */
constexpr std::size_t kMapPointsPerBatch =
    20;


/*
 * 有ADD积压时，
 * 优先预留最多8个DELETE位置。
 */
constexpr std::size_t kPreferredDeletesPerBatch =
    8;


/*
 * 有ADD积压时，
 * 优先预留最多6个UPDATE位置。
 */
constexpr std::size_t kPreferredUpdatesPerBatch =
    6;


/*
 * Batch约2 Hz。
 */
constexpr std::uint32_t kMapBatchPublishStride =
    15;


/*
 * MapPoint变化达到2cm才UPDATE。
 */
constexpr float kMapPointUpdateThresholdMeters =
    0.02F;


/*
 * ==========================================================
 * DELETE保护
 * ==========================================================
 *
 * 一个已同步点必须连续2次Batch
 * 都不在ORB-SLAM3当前有效Map中，
 * 才真正发送DELETE。
 *
 * Batch约2Hz，因此大约：
 *
 * 0.5s × 2 ≈ 1秒
 */
constexpr std::uint32_t kDeleteMissingBatchThreshold =
    2;


/*
 * Tracking状态名称。
 */
const char* TrackingStateName(
    const int state)
{
    switch (state)
    {
        case -1:
            return "SYSTEM_NOT_READY";

        case 0:
            return "NO_IMAGES_YET";

        case 1:
            return "NOT_INITIALIZED";

        case 2:
            return "OK";

        case 3:
            return "RECENTLY_LOST";

        case 4:
            return "LOST";

        case 5:
            return "OK_KLT";

        default:
            return "UNKNOWN";
    }
}

} // namespace



StereoSlamNode::StereoSlamNode(
    ORB_SLAM3::System* pSLAM,
    const std::string& strSettingsFile,
    const std::string& strDoRectify)
    :
    Node("ORB_SLAM3_ROS2"),
    m_SLAM(pSLAM)
{
    std::stringstream ss(
        strDoRectify);


    if (!(ss >> std::boolalpha >> doRectify))
    {
        RCLCPP_WARN(
            this->get_logger(),
            "Invalid rectify option '%s', using false",
            strDoRectify.c_str());

        doRectify = false;
    }


    /*
     * ==========================================================
     * 双目矫正
     * ==========================================================
     */

    if (doRectify)
    {
        cv::FileStorage fsSettings(
            strSettingsFile,
            cv::FileStorage::READ);


        if (!fsSettings.isOpened())
        {
            throw std::runtime_error(
                "Wrong path to ORB-SLAM3 settings file: " +
                strSettingsFile);
        }


        cv::Mat K_l;
        cv::Mat K_r;

        cv::Mat P_l;
        cv::Mat P_r;

        cv::Mat R_l;
        cv::Mat R_r;

        cv::Mat D_l;
        cv::Mat D_r;


        fsSettings["LEFT.K"] >> K_l;
        fsSettings["RIGHT.K"] >> K_r;

        fsSettings["LEFT.P"] >> P_l;
        fsSettings["RIGHT.P"] >> P_r;

        fsSettings["LEFT.R"] >> R_l;
        fsSettings["RIGHT.R"] >> R_r;

        fsSettings["LEFT.D"] >> D_l;
        fsSettings["RIGHT.D"] >> D_r;


        const int rows_l =
            static_cast<int>(
                fsSettings["LEFT.height"]);


        const int cols_l =
            static_cast<int>(
                fsSettings["LEFT.width"]);


        const int rows_r =
            static_cast<int>(
                fsSettings["RIGHT.height"]);


        const int cols_r =
            static_cast<int>(
                fsSettings["RIGHT.width"]);


        if (
            K_l.empty() ||
            K_r.empty() ||
            P_l.empty() ||
            P_r.empty() ||
            R_l.empty() ||
            R_r.empty() ||
            D_l.empty() ||
            D_r.empty() ||
            rows_l == 0 ||
            rows_r == 0 ||
            cols_l == 0 ||
            cols_r == 0)
        {
            throw std::runtime_error(
                "Calibration parameters used to rectify "
                "stereo images are missing");
        }


        cv::initUndistortRectifyMap(
            K_l,
            D_l,
            R_l,
            P_l.rowRange(0, 3).colRange(0, 3),
            cv::Size(cols_l, rows_l),
            CV_32F,
            M1l,
            M2l);


        cv::initUndistortRectifyMap(
            K_r,
            D_r,
            R_r,
            P_r.rowRange(0, 3).colRange(0, 3),
            cv::Size(cols_r, rows_r),
            CV_32F,
            M1r,
            M2r);
    }


    /*
     * ==========================================================
     * ROS2 Publisher
     * ==========================================================
     */

    pose_pub_ =
        this->create_publisher<
            geometry_msgs::msg::PoseStamped>(
                "/orbslam3/pose",
                rclcpp::QoS(10));


    tracking_state_pub_ =
        this->create_publisher<
            std_msgs::msg::Int32>(
                "/orbslam3/tracking_state",
                rclcpp::QoS(10));


    path_pub_ =
        this->create_publisher<
            nav_msgs::msg::Path>(
                "/orbslam3/path",
                rclcpp::QoS(
                    rclcpp::KeepLast(1))
                    .reliable()
                    .transient_local());


    map_points_pub_ =
        this->create_publisher<
            sensor_msgs::msg::PointCloud2>(
                "/orbslam3/map_points",
                rclcpp::QoS(1));


    path_msg_.header.frame_id =
        kOrbMapFrame;


    /*
     * ==========================================================
     * 双目Subscriber
     * ==========================================================
     */

    const auto image_qos =
        rclcpp::SensorDataQoS()
            .get_rmw_qos_profile();


    left_sub =
        std::make_shared<
            message_filters::Subscriber<ImageMsg>>(
                this,
                "/left/image_rect",
                image_qos);


    right_sub =
        std::make_shared<
            message_filters::Subscriber<ImageMsg>>(
                this,
                "/right/image_rect",
                image_qos);


    syncApproximate =
        std::make_shared<
            message_filters::Synchronizer<
                ApproximateSyncPolicy>>(
                    ApproximateSyncPolicy(10),
                    *left_sub,
                    *right_sub);


    syncApproximate->registerCallback(
        std::bind(
            &StereoSlamNode::GrabStereo,
            this,
            _1,
            _2));


    /*
     * ==========================================================
     * 启动日志
     * ==========================================================
     */

    RCLCPP_INFO(
        this->get_logger(),
        "Stereo SLAM publishers initialized");


    RCLCPP_INFO(
        this->get_logger(),
        "Pose topic: /orbslam3/pose");


    RCLCPP_INFO(
        this->get_logger(),
        "Tracking state topic: "
        "/orbslam3/tracking_state");


    RCLCPP_INFO(
        this->get_logger(),
        "Path topic: /orbslam3/path");


    RCLCPP_INFO(
        this->get_logger(),
        "Map points topic: "
        "/orbslam3/map_points");


    RCLCPP_INFO(
        this->get_logger(),
        "MapPoint Batch V3 initialized: "
        "max=%zu delete_pref=%zu "
        "update_pref=%zu stride=%u "
        "update_threshold=%.3f m "
        "delete_missing_batches=%u",
        kMapPointsPerBatch,
        kPreferredDeletesPerBatch,
        kPreferredUpdatesPerBatch,
        kMapBatchPublishStride,
        kMapPointUpdateThresholdMeters,
        kDeleteMissingBatchThreshold);
}



StereoSlamNode::~StereoSlamNode()
{
    if (m_SLAM == nullptr)
    {
        return;
    }


    m_SLAM->Shutdown();


    if (has_valid_pose_)
    {
        m_SLAM->SaveTrajectoryTUM(
            "CameraTrajectory.txt");


        m_SLAM->SaveKeyFrameTrajectoryTUM(
            "KeyFrameTrajectory.txt");


        RCLCPP_INFO(
            this->get_logger(),
            "Saved CameraTrajectory.txt and "
            "KeyFrameTrajectory.txt");
    }
    else
    {
        RCLCPP_WARN(
            this->get_logger(),
            "No valid SLAM pose was generated; "
            "trajectory files were not saved");
    }
}



void StereoSlamNode::GrabStereo(
    const ImageMsg::ConstSharedPtr& msgLeft,
    const ImageMsg::ConstSharedPtr& msgRight)
{
    try
    {
        cv_ptrLeft =
            cv_bridge::toCvShare(
                msgLeft);
    }
    catch (const cv_bridge::Exception& e)
    {
        RCLCPP_ERROR(
            this->get_logger(),
            "Left image cv_bridge exception: %s",
            e.what());

        return;
    }


    try
    {
        cv_ptrRight =
            cv_bridge::toCvShare(
                msgRight);
    }
    catch (const cv_bridge::Exception& e)
    {
        RCLCPP_ERROR(
            this->get_logger(),
            "Right image cv_bridge exception: %s",
            e.what());

        return;
    }


    Sophus::SE3f Tcw;


    const double timestamp =
        Utility::StampToSec(
            msgLeft->header.stamp);


    if (doRectify)
    {
        cv::Mat imLeft;
        cv::Mat imRight;


        cv::remap(
            cv_ptrLeft->image,
            imLeft,
            M1l,
            M2l,
            cv::INTER_LINEAR);


        cv::remap(
            cv_ptrRight->image,
            imRight,
            M1r,
            M2r,
            cv::INTER_LINEAR);


        Tcw =
            m_SLAM->TrackStereo(
                imLeft,
                imRight,
                timestamp);
    }
    else
    {
        Tcw =
            m_SLAM->TrackStereo(
                cv_ptrLeft->image,
                cv_ptrRight->image,
                timestamp);
    }


    PublishSlamOutputs(
        Tcw,
        msgLeft->header);
}



void StereoSlamNode::PublishTrackedMapPoints(
    const std_msgs::msg::Header& imageHeader)
{
    const std::vector<ORB_SLAM3::MapPoint*> map_points =
        m_SLAM->GetAllMapPoints();


    if (map_points.empty())
    {
        return;
    }


    const std::size_t sampling_stride =
        std::max<std::size_t>(
            1,
            (
                map_points.size() +
                kMaxPublishedMapPoints -
                1
            )
            /
            kMaxPublishedMapPoints);


    std::vector<Eigen::Vector3f> valid_points;


    valid_points.reserve(
        std::min(
            map_points.size(),
            kMaxPublishedMapPoints));


    for (
        std::size_t i = 0;
        i < map_points.size();
        i += sampling_stride)
    {
        ORB_SLAM3::MapPoint* pMP =
            map_points[i];


        if (pMP == nullptr)
        {
            continue;
        }


        if (pMP->isBad())
        {
            continue;
        }


        const Eigen::Vector3f world_pos =
            pMP->GetWorldPos();


        if (
            !std::isfinite(world_pos.x()) ||
            !std::isfinite(world_pos.y()) ||
            !std::isfinite(world_pos.z()))
        {
            continue;
        }


        valid_points.push_back(
            world_pos);


        if (
            valid_points.size() >=
            kMaxPublishedMapPoints)
        {
            break;
        }
    }


    if (valid_points.empty())
    {
        return;
    }


    sensor_msgs::msg::PointCloud2 cloud_msg;


    cloud_msg.header.stamp =
        imageHeader.stamp;


    cloud_msg.header.frame_id =
        kOrbMapFrame;


    cloud_msg.height =
        1;


    sensor_msgs::PointCloud2Modifier modifier(
        cloud_msg);


    modifier.setPointCloud2FieldsByString(
        1,
        "xyz");


    modifier.resize(
        valid_points.size());


    sensor_msgs::PointCloud2Iterator<float>
        iter_x(
            cloud_msg,
            "x");


    sensor_msgs::PointCloud2Iterator<float>
        iter_y(
            cloud_msg,
            "y");


    sensor_msgs::PointCloud2Iterator<float>
        iter_z(
            cloud_msg,
            "z");


    for (
        const Eigen::Vector3f& point :
        valid_points)
    {
        *iter_x =
            static_cast<float>(
                point.x());


        *iter_y =
            static_cast<float>(
                point.y());


        *iter_z =
            static_cast<float>(
                point.z());


        ++iter_x;
        ++iter_y;
        ++iter_z;
    }


    cloud_msg.is_dense =
        true;


    map_points_pub_->publish(
        cloud_msg);
}



void StereoSlamNode::PrepareMapPointBatch()
{
    /*
     * ==========================================================
     * 获取当前ORB-SLAM3地图
     * ==========================================================
     */

    const std::vector<ORB_SLAM3::MapPoint*> map_points =
        m_SLAM->GetAllMapPoints();


    /*
     * 即使当前地图为空，
     * DELETE机制以后可能仍需要处理旧点。
     *
     * 因此这里不直接return。
     */


    /*
     * 当前MapPoint快照。
     */
    struct MapPointSnapshot
    {
        unsigned long id;

        float x;
        float y;
        float z;
    };


    std::vector<MapPointSnapshot> snapshots;


    snapshots.reserve(
        map_points.size());


    /*
     * 当前有效mnId集合。
     *
     * DELETE检测使用。
     */
    std::unordered_set<unsigned long>
        current_ids;


    current_ids.reserve(
        map_points.size());


    /*
     * ==========================================================
     * 当前有效MapPoint快照
     * ==========================================================
     */

    for (
        ORB_SLAM3::MapPoint* pMP :
        map_points)
    {
        if (pMP == nullptr)
        {
            continue;
        }


        if (pMP->isBad())
        {
            continue;
        }


        const Eigen::Vector3f world_pos =
            pMP->GetWorldPos();


        if (
            !std::isfinite(world_pos.x()) ||
            !std::isfinite(world_pos.y()) ||
            !std::isfinite(world_pos.z()))
        {
            continue;
        }


        MapPointSnapshot snapshot;


        snapshot.id =
            pMP->mnId;


        snapshot.x =
            world_pos.x();


        snapshot.y =
            world_pos.y();


        snapshot.z =
            world_pos.z();


        snapshots.push_back(
            snapshot);


        current_ids.insert(
            snapshot.id);
    }


    /*
     * ==========================================================
     * 候选队列
     * ==========================================================
     */

    std::vector<MapPointBatchData>
        delete_candidates;


    std::vector<MapPointBatchData>
        update_candidates;


    std::vector<MapPointBatchData>
        add_candidates;


    /*
     * ==========================================================
     * DELETE候选检测
     * ==========================================================
     *
     * last_sent中存在
     *
     * 但current_ids连续多个Batch不存在
     *
     * => DELETE
     */

    for (
        const auto& entry :
        last_sent_map_points_)
    {
        const unsigned long id =
            entry.first;


        /*
         * 当前仍然存在。
         *
         * 清除缺失计数。
         */
        if (
            current_ids.find(id) !=
            current_ids.end())
        {
            map_point_missing_counts_.erase(
                id);

            continue;
        }


        /*
         * 当前Batch没有找到该ID。
         */
        std::uint32_t& missing_count =
            map_point_missing_counts_[id];


        ++missing_count;


        /*
         * 还没有达到DELETE保护阈值。
         */
        if (
            missing_count <
            kDeleteMissingBatchThreshold)
        {
            continue;
        }


        /*
         * DELETE候选。
         */
        MapPointBatchData point;


        point.operation =
            MapPointBatchOperation::DELETE;


        point.id =
            id;


        point.x =
            0.0F;

        point.y =
            0.0F;

        point.z =
            0.0F;


        point.previous_x =
            entry.second.x;

        point.previous_y =
            entry.second.y;

        point.previous_z =
            entry.second.z;


        point.delta =
            0.0F;


        delete_candidates.push_back(
            point);
    }


    /*
     * ==========================================================
     * ADD / UPDATE候选
     * ==========================================================
     */

    const float update_threshold_squared =
        kMapPointUpdateThresholdMeters *
        kMapPointUpdateThresholdMeters;


    for (
        const MapPointSnapshot& snapshot :
        snapshots)
    {
        const auto it =
            last_sent_map_points_.find(
                snapshot.id);


        /*
         * ======================================================
         * ADD
         * ======================================================
         */
        if (
            it ==
            last_sent_map_points_.end())
        {
            MapPointBatchData point;


            point.operation =
                MapPointBatchOperation::ADD;


            point.id =
                snapshot.id;


            point.x =
                snapshot.x;

            point.y =
                snapshot.y;

            point.z =
                snapshot.z;


            point.previous_x =
                snapshot.x;

            point.previous_y =
                snapshot.y;

            point.previous_z =
                snapshot.z;


            point.delta =
                0.0F;


            add_candidates.push_back(
                point);


            continue;
        }


        /*
         * ======================================================
         * UPDATE
         * ======================================================
         */

        const float dx =
            snapshot.x -
            it->second.x;


        const float dy =
            snapshot.y -
            it->second.y;


        const float dz =
            snapshot.z -
            it->second.z;


        const float distance_squared =
            dx * dx +
            dy * dy +
            dz * dz;


        /*
         * 不达到2cm：
         *
         * 不发送UPDATE。
         */
        if (
            distance_squared <
            update_threshold_squared)
        {
            continue;
        }


        MapPointBatchData point;


        point.operation =
            MapPointBatchOperation::UPDATE;


        point.id =
            snapshot.id;


        point.x =
            snapshot.x;

        point.y =
            snapshot.y;

        point.z =
            snapshot.z;


        point.previous_x =
            it->second.x;

        point.previous_y =
            it->second.y;

        point.previous_z =
            it->second.z;


        point.delta =
            std::sqrt(
                distance_squared);


        update_candidates.push_back(
            point);
    }


    /*
     * ==========================================================
     * 没有任何增量变化
     * ==========================================================
     */

    if (
        delete_candidates.empty() &&
        update_candidates.empty() &&
        add_candidates.empty())
    {
        return;
    }


    /*
     * ==========================================================
     * 构造最终20条Batch
     * ==========================================================
     *
     * 默认策略：
     *
     * DELETE最多优先8
     * UPDATE最多优先6
     * ADD填剩余
     *
     * 如果ADD不足：
     *
     * 再继续使用剩余DELETE / UPDATE候选。
     */

    std::vector<MapPointBatchData> batch;


    batch.reserve(
        kMapPointsPerBatch);


    std::size_t delete_index =
        0;


    std::size_t update_index =
        0;


    std::size_t add_index =
        0;


    /*
     * ==========================================================
     * 第一阶段：DELETE
     * ==========================================================
     */

    while (
        delete_index <
            delete_candidates.size() &&
        delete_index <
            kPreferredDeletesPerBatch &&
        batch.size() <
            kMapPointsPerBatch)
    {
        batch.push_back(
            delete_candidates[
                delete_index]);


        ++delete_index;
    }


    /*
     * ==========================================================
     * 第二阶段：UPDATE
     * ==========================================================
     */

    while (
        update_index <
            update_candidates.size() &&
        update_index <
            kPreferredUpdatesPerBatch &&
        batch.size() <
            kMapPointsPerBatch)
    {
        batch.push_back(
            update_candidates[
                update_index]);


        ++update_index;
    }


    /*
     * ==========================================================
     * 第三阶段：ADD填满剩余空间
     * ==========================================================
     */

    while (
        add_index <
            add_candidates.size() &&
        batch.size() <
            kMapPointsPerBatch)
    {
        batch.push_back(
            add_candidates[
                add_index]);


        ++add_index;
    }


    /*
     * ==========================================================
     * ADD不足时继续DELETE
     * ==========================================================
     */

    while (
        delete_index <
            delete_candidates.size() &&
        batch.size() <
            kMapPointsPerBatch)
    {
        batch.push_back(
            delete_candidates[
                delete_index]);


        ++delete_index;
    }


    /*
     * ==========================================================
     * 如果仍有空间，再继续UPDATE
     * ==========================================================
     */

    while (
        update_index <
            update_candidates.size() &&
        batch.size() <
            kMapPointsPerBatch)
    {
        batch.push_back(
            update_candidates[
                update_index]);


        ++update_index;
    }


    /*
     * 理论保护。
     */
    if (batch.empty())
    {
        return;
    }


    /*
     * ==========================================================
     * V3仍然模拟发送成功
     * ==========================================================
     *
     * 真正UART/LoRa阶段：
     *
     * 这里不能立即修改同步状态。
     *
     * 必须等ACK以后再做。
     */

    std::size_t batch_add_count =
        0;


    std::size_t batch_update_count =
        0;


    std::size_t batch_delete_count =
        0;


    for (
        const MapPointBatchData& point :
        batch)
    {
        /*
         * ======================================================
         * ADD
         * ======================================================
         */
        if (
            point.operation ==
            MapPointBatchOperation::ADD)
        {
            LastSentMapPointData state;


            state.x =
                point.x;

            state.y =
                point.y;

            state.z =
                point.z;


            last_sent_map_points_[
                point.id] =
                state;


            /*
             * ADD成功后，
             * 不应该存在缺失记录。
             */
            map_point_missing_counts_.erase(
                point.id);


            ++batch_add_count;

            ++map_point_add_total_;
        }


        /*
         * ======================================================
         * UPDATE
         * ======================================================
         */
        else if (
            point.operation ==
            MapPointBatchOperation::UPDATE)
        {
            LastSentMapPointData state;


            state.x =
                point.x;

            state.y =
                point.y;

            state.z =
                point.z;


            last_sent_map_points_[
                point.id] =
                state;


            map_point_missing_counts_.erase(
                point.id);


            ++batch_update_count;

            ++map_point_update_total_;
        }


        /*
         * ======================================================
         * DELETE
         * ======================================================
         */
        else
        {
            /*
             * PC被认为已经删除该点。
             *
             * 因此本地同步缓存也删除。
             */
            last_sent_map_points_.erase(
                point.id);


            map_point_missing_counts_.erase(
                point.id);


            ++batch_delete_count;

            ++map_point_delete_total_;
        }
    }


    /*
     * ==========================================================
     * Batch统计
     * ==========================================================
     */

    RCLCPP_INFO(
        this->get_logger(),
        "[MapBatchV3] "
        "valid=%zu "
        "add_pending=%zu "
        "update_pending=%zu "
        "delete_pending=%zu "
        "batch=%zu "
        "add=%zu "
        "update=%zu "
        "delete=%zu "
        "synced_now=%zu "
        "add_total=%zu "
        "update_total=%zu "
        "delete_total=%zu",
        snapshots.size(),
        add_candidates.size(),
        update_candidates.size(),
        delete_candidates.size(),
        batch.size(),
        batch_add_count,
        batch_update_count,
        batch_delete_count,
        last_sent_map_points_.size(),
        map_point_add_total_,
        map_point_update_total_,
        map_point_delete_total_);


    /*
     * ==========================================================
     * 打印Batch内容
     * ==========================================================
     */

    for (
        const MapPointBatchData& point :
        batch)
    {
        /*
         * ADD
         */
        if (
            point.operation ==
            MapPointBatchOperation::ADD)
        {
            RCLCPP_INFO(
                this->get_logger(),
                "  ADD id=%lu "
                "xyz=(%.3f, %.3f, %.3f)",
                point.id,
                point.x,
                point.y,
                point.z);
        }


        /*
         * UPDATE
         */
        else if (
            point.operation ==
            MapPointBatchOperation::UPDATE)
        {
            RCLCPP_INFO(
                this->get_logger(),
                "  UPDATE id=%lu "
                "old=(%.3f, %.3f, %.3f) "
                "new=(%.3f, %.3f, %.3f) "
                "delta=%.3f m",
                point.id,
                point.previous_x,
                point.previous_y,
                point.previous_z,
                point.x,
                point.y,
                point.z,
                point.delta);
        }


        /*
         * DELETE
         */
        else
        {
            RCLCPP_INFO(
                this->get_logger(),
                "  DELETE id=%lu "
                "last_xyz=(%.3f, %.3f, %.3f)",
                point.id,
                point.previous_x,
                point.previous_y,
                point.previous_z);
        }
    }
}



void StereoSlamNode::PublishSlamOutputs(
    const Sophus::SE3f& Tcw,
    const std_msgs::msg::Header& imageHeader)
{
    /*
     * ==========================================================
     * Tracking状态
     * ==========================================================
     */

    const int tracking_state =
        m_SLAM->GetTrackingState();


    std_msgs::msg::Int32 state_msg;


    state_msg.data =
        tracking_state;


    tracking_state_pub_->publish(
        state_msg);


    if (
        tracking_state !=
        last_tracking_state_)
    {
        RCLCPP_INFO(
            this->get_logger(),
            "ORB-SLAM3 tracking state: %d (%s)",
            tracking_state,
            TrackingStateName(
                tracking_state));


        last_tracking_state_ =
            tracking_state;
    }


    /*
     * 只有Tracking::OK才发布有效数据。
     */
    if (
        tracking_state !=
        ORB_SLAM3::Tracking::OK)
    {
        return;
    }


    /*
     * ==========================================================
     * Tcw -> Twc
     * ==========================================================
     */

    const Sophus::SE3f Twc =
        Tcw.inverse();


    const Eigen::Vector3f translation =
        Twc.translation();


    Eigen::Quaternionf quaternion =
        Twc.unit_quaternion();


    quaternion.normalize();


    /*
     * Pose合法性。
     */
    const bool pose_is_finite =
        std::isfinite(
            translation.x()) &&
        std::isfinite(
            translation.y()) &&
        std::isfinite(
            translation.z()) &&
        std::isfinite(
            quaternion.x()) &&
        std::isfinite(
            quaternion.y()) &&
        std::isfinite(
            quaternion.z()) &&
        std::isfinite(
            quaternion.w());


    if (!pose_is_finite)
    {
        RCLCPP_WARN(
            this->get_logger(),
            "ORB-SLAM3 returned a "
            "non-finite pose");

        return;
    }


    /*
     * ==========================================================
     * PoseStamped
     * ==========================================================
     */

    geometry_msgs::msg::PoseStamped pose_msg;


    pose_msg.header.stamp =
        imageHeader.stamp;


    pose_msg.header.frame_id =
        kOrbMapFrame;


    pose_msg.pose.position.x =
        static_cast<double>(
            translation.x());


    pose_msg.pose.position.y =
        static_cast<double>(
            translation.y());


    pose_msg.pose.position.z =
        static_cast<double>(
            translation.z());


    pose_msg.pose.orientation.x =
        static_cast<double>(
            quaternion.x());


    pose_msg.pose.orientation.y =
        static_cast<double>(
            quaternion.y());


    pose_msg.pose.orientation.z =
        static_cast<double>(
            quaternion.z());


    pose_msg.pose.orientation.w =
        static_cast<double>(
            quaternion.w());


    pose_pub_->publish(
        pose_msg);


    has_valid_pose_ =
        true;


    /*
     * ==========================================================
     * RViz地图点
     * ==========================================================
     */

    ++map_points_decimation_counter_;


    if (
        (
            map_points_decimation_counter_
            %
            kMapPointsPublishStride
        )
        ==
        0)
    {
        PublishTrackedMapPoints(
            imageHeader);
    }


    /*
     * ==========================================================
     * 通信MapPoint Batch V3
     * ==========================================================
     */

    ++map_batch_decimation_counter_;


    if (
        (
            map_batch_decimation_counter_
            %
            kMapBatchPublishStride
        )
        ==
        0)
    {
        PrepareMapPointBatch();
    }


    /*
     * ==========================================================
     * Path
     * ==========================================================
     */

    ++path_decimation_counter_;


    if (
        (
            path_decimation_counter_
            %
            kPathPublishStride
        )
        !=
        0)
    {
        return;
    }


    path_msg_.header.stamp =
        imageHeader.stamp;


    path_msg_.header.frame_id =
        kOrbMapFrame;


    path_msg_.poses.push_back(
        pose_msg);


    if (
        path_msg_.poses.size() >
        kMaxPathPoses)
    {
        path_msg_.poses.erase(
            path_msg_.poses.begin(),
            path_msg_.poses.begin() +
                500);
    }


    path_pub_->publish(
        path_msg_);
}