#include "stereo-slam-node.hpp"

#include <algorithm>
#include <cmath>
#include <cstddef>
#include <cstdint>
#include <functional>
#include <iomanip>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <vector>

#include <Eigen/Geometry>

#include <opencv2/core/core.hpp>
#include <opencv2/calib3d.hpp>
#include <opencv2/imgproc.hpp>

#include "sensor_msgs/point_cloud2_iterator.hpp"


using std::placeholders::_1;
using std::placeholders::_2;


namespace
{

/*
 * 当前发布的是ORB-SLAM3原始世界坐标系。
 *
 * 当前并不是小车的base_link坐标系，
 * 因此统一命名为：
 *
 * orb_map
 */
constexpr const char* kOrbMapFrame =
    "orb_map";


/*
 * 假设相机运行约30 FPS。
 *
 * 每3个正常跟踪帧加入一次Path：
 *
 * 30 / 3 ≈ 10 Hz
 */
constexpr std::uint32_t kPathPublishStride =
    3;


/*
 * 防止nav_msgs/Path无限增长。
 */
constexpr std::size_t kMaxPathPoses =
    2000;


/*
 * ==========================================================
 * RViz MapPoint发布参数
 * ==========================================================
 *
 * MapPoints没有必要30 Hz发布。
 *
 * 每15个正常跟踪帧发布一次：
 *
 * 30 / 15 ≈ 2 Hz
 */
constexpr std::uint32_t kMapPointsPublishStride =
    15;


/*
 * 当前ROS2测试阶段，
 * 每次最多发布300个MapPoint。
 *
 * 后续真正通过UART + LoRa传输时，
 * 还会进行进一步：
 *
 * 1. 筛选
 * 2. 压缩
 * 3. XYZ量化
 * 4. int16_t编码
 */
constexpr std::size_t kMaxPublishedMapPoints =
    300;


/*
 * ==========================================================
 * MapPoint通信Batch参数
 * ==========================================================
 */


/*
 * 每个通信Batch最多包含20个MapPoint。
 */
constexpr std::size_t kMapPointsPerBatch =
    20;


/*
 * 当前相机约30 FPS。
 *
 * 每15个正常跟踪帧尝试生成一次Batch：
 *
 * 30 / 15 ≈ 2 Hz
 *
 * 也就是大约：
 *
 * 0.5秒 / Batch
 *
 * 注意：
 *
 * 该参数与RViz中的MapPoint发布频率独立。
 */
constexpr std::uint32_t kMapBatchPublishStride =
    15;


/*
 * 将ORB-SLAM3数字跟踪状态转换成文字。
 *
 * 使用数值判断可以兼容不同ORB-SLAM3版本。
 */
const char* TrackingStateName(
    const int state)
{
    switch (state)
    {
        case -1:
            return "SYSTEM_NOT_READY";

        case 0:
            return "NO_IMAGES_YET";

        case 1:
            return "NOT_INITIALIZED";

        case 2:
            return "OK";

        case 3:
            return "RECENTLY_LOST";

        case 4:
            return "LOST";

        case 5:
            return "OK_KLT";

        default:
            return "UNKNOWN";
    }
}

} // namespace



StereoSlamNode::StereoSlamNode(
    ORB_SLAM3::System* pSLAM,
    const std::string& strSettingsFile,
    const std::string& strDoRectify)
    :
    Node("ORB_SLAM3_ROS2"),
    m_SLAM(pSLAM)
{
    /*
     * 读取命令行中的true/false。
     */
    std::stringstream ss(
        strDoRectify);

    if (!(ss >> std::boolalpha >> doRectify))
    {
        RCLCPP_WARN(
            this->get_logger(),
            "Invalid rectify option '%s', using false",
            strDoRectify.c_str());

        doRectify = false;
    }


    /*
     * 如果要求在ROS节点中进行图像矫正，
     * 则读取ORB-SLAM3 YAML中的双目标定参数。
     */
    if (doRectify)
    {
        cv::FileStorage fsSettings(
            strSettingsFile,
            cv::FileStorage::READ);


        if (!fsSettings.isOpened())
        {
            throw std::runtime_error(
                "Wrong path to ORB-SLAM3 settings file: " +
                strSettingsFile);
        }


        cv::Mat K_l;
        cv::Mat K_r;

        cv::Mat P_l;
        cv::Mat P_r;

        cv::Mat R_l;
        cv::Mat R_r;

        cv::Mat D_l;
        cv::Mat D_r;


        fsSettings["LEFT.K"] >> K_l;
        fsSettings["RIGHT.K"] >> K_r;

        fsSettings["LEFT.P"] >> P_l;
        fsSettings["RIGHT.P"] >> P_r;

        fsSettings["LEFT.R"] >> R_l;
        fsSettings["RIGHT.R"] >> R_r;

        fsSettings["LEFT.D"] >> D_l;
        fsSettings["RIGHT.D"] >> D_r;


        const int rows_l =
            static_cast<int>(
                fsSettings["LEFT.height"]);

        const int cols_l =
            static_cast<int>(
                fsSettings["LEFT.width"]);

        const int rows_r =
            static_cast<int>(
                fsSettings["RIGHT.height"]);

        const int cols_r =
            static_cast<int>(
                fsSettings["RIGHT.width"]);


        if (K_l.empty() ||
            K_r.empty() ||
            P_l.empty() ||
            P_r.empty() ||
            R_l.empty() ||
            R_r.empty() ||
            D_l.empty() ||
            D_r.empty() ||
            rows_l == 0 ||
            rows_r == 0 ||
            cols_l == 0 ||
            cols_r == 0)
        {
            throw std::runtime_error(
                "Calibration parameters used to rectify "
                "stereo images are missing");
        }


        /*
         * 生成左相机矫正映射。
         */
        cv::initUndistortRectifyMap(
            K_l,
            D_l,
            R_l,
            P_l.rowRange(0, 3).colRange(0, 3),
            cv::Size(cols_l, rows_l),
            CV_32F,
            M1l,
            M2l);


        /*
         * 生成右相机矫正映射。
         */
        cv::initUndistortRectifyMap(
            K_r,
            D_r,
            R_r,
            P_r.rowRange(0, 3).colRange(0, 3),
            cv::Size(cols_r, rows_r),
            CV_32F,
            M1r,
            M2r);
    }


    /*
     * ==========================================================
     * 创建ORB-SLAM3 ROS2输出Publisher
     * ==========================================================
     */


    /*
     * 当前位姿。
     */
    pose_pub_ =
        this->create_publisher<
            geometry_msgs::msg::PoseStamped>(
                "/orbslam3/pose",
                rclcpp::QoS(10));


    /*
     * 当前跟踪状态。
     */
    tracking_state_pub_ =
        this->create_publisher<
            std_msgs::msg::Int32>(
                "/orbslam3/tracking_state",
                rclcpp::QoS(10));


    /*
     * 在线轨迹。
     *
     * transient_local：
     *
     * RViz稍晚启动时，
     * 仍有机会收到最近一次完整Path。
     */
    path_pub_ =
        this->create_publisher<
            nav_msgs::msg::Path>(
                "/orbslam3/path",
                rclcpp::QoS(
                    rclcpp::KeepLast(1))
                    .reliable()
                    .transient_local());


    /*
     * ORB-SLAM3稀疏三维地图点。
     *
     * 第一阶段使用PointCloud2，
     * 方便ROS2和RViz直接验证。
     */
    map_points_pub_ =
        this->create_publisher<
            sensor_msgs::msg::PointCloud2>(
                "/orbslam3/map_points",
                rclcpp::QoS(1));


    /*
     * Path与MapPoint统一使用ORB-SLAM3世界坐标系。
     */
    path_msg_.header.frame_id =
        kOrbMapFrame;


    /*
     * ==========================================================
     * 创建双目图像Subscriber
     * ==========================================================
     */


    /*
     * RealSense图像通常使用SensorDataQoS。
     *
     * message_filters如果使用默认QoS，
     * 有可能与RealSense Publisher不兼容。
     *
     * 因此显式使用SensorDataQoS。
     */
    const auto image_qos =
        rclcpp::SensorDataQoS()
            .get_rmw_qos_profile();


    /*
     * 左图。
     *
     * 实际运行时通过ROS remap连接到：
     *
     * /camera/camera/infra1/image_rect_raw
     */
    left_sub =
        std::make_shared<
            message_filters::Subscriber<ImageMsg>>(
                this,
                "/left/image_rect",
                image_qos);


    /*
     * 右图。
     *
     * 实际运行时通过ROS remap连接到：
     *
     * /camera/camera/infra2/image_rect_raw
     */
    right_sub =
        std::make_shared<
            message_filters::Subscriber<ImageMsg>>(
                this,
                "/right/image_rect",
                image_qos);


    /*
     * ApproximateTime双目同步。
     */
    syncApproximate =
        std::make_shared<
            message_filters::Synchronizer<
                ApproximateSyncPolicy>>(
                    ApproximateSyncPolicy(10),
                    *left_sub,
                    *right_sub);


    syncApproximate->registerCallback(
        std::bind(
            &StereoSlamNode::GrabStereo,
            this,
            _1,
            _2));


    /*
     * ==========================================================
     * 启动日志
     * ==========================================================
     */


    RCLCPP_INFO(
        this->get_logger(),
        "Stereo SLAM publishers initialized");


    RCLCPP_INFO(
        this->get_logger(),
        "Pose topic: /orbslam3/pose");


    RCLCPP_INFO(
        this->get_logger(),
        "Tracking state topic: "
        "/orbslam3/tracking_state");


    RCLCPP_INFO(
        this->get_logger(),
        "Path topic: /orbslam3/path");


    RCLCPP_INFO(
        this->get_logger(),
        "Map points topic: "
        "/orbslam3/map_points");


    RCLCPP_INFO(
        this->get_logger(),
        "MapPoint ADD Batch initialized: "
        "max_points=%zu stride=%u",
        kMapPointsPerBatch,
        kMapBatchPublishStride);
}



StereoSlamNode::~StereoSlamNode()
{
    if (m_SLAM == nullptr)
    {
        return;
    }


    /*
     * 保存轨迹之前，
     * 必须首先停止ORB-SLAM3内部线程。
     */
    m_SLAM->Shutdown();


    /*
     * SaveTrajectoryTUM内部要求存在有效地图。
     *
     * 如果程序启动后始终没有正常SLAM位姿，
     * 就不调用轨迹保存接口。
     */
    if (has_valid_pose_)
    {
        /*
         * 普通相机帧轨迹。
         *
         * 纯Stereo支持该接口。
         */
        m_SLAM->SaveTrajectoryTUM(
            "CameraTrajectory.txt");


        /*
         * KeyFrame轨迹。
         */
        m_SLAM->SaveKeyFrameTrajectoryTUM(
            "KeyFrameTrajectory.txt");


        RCLCPP_INFO(
            this->get_logger(),
            "Saved CameraTrajectory.txt and "
            "KeyFrameTrajectory.txt");
    }
    else
    {
        RCLCPP_WARN(
            this->get_logger(),
            "No valid SLAM pose was generated; "
            "trajectory files were not saved");
    }
}



void StereoSlamNode::GrabStereo(
    const ImageMsg::ConstSharedPtr& msgLeft,
    const ImageMsg::ConstSharedPtr& msgRight)
{
    /*
     * ==========================================================
     * 左图 ROS -> OpenCV
     * ==========================================================
     */

    try
    {
        cv_ptrLeft =
            cv_bridge::toCvShare(
                msgLeft);
    }
    catch (const cv_bridge::Exception& e)
    {
        RCLCPP_ERROR(
            this->get_logger(),
            "Left image cv_bridge exception: %s",
            e.what());

        return;
    }


    /*
     * ==========================================================
     * 右图 ROS -> OpenCV
     * ==========================================================
     */

    try
    {
        cv_ptrRight =
            cv_bridge::toCvShare(
                msgRight);
    }
    catch (const cv_bridge::Exception& e)
    {
        RCLCPP_ERROR(
            this->get_logger(),
            "Right image cv_bridge exception: %s",
            e.what());

        return;
    }


    /*
     * ORB-SLAM3 TrackStereo返回：
     *
     * Tcw
     *
     * 即：
     *
     * World -> Camera
     */
    Sophus::SE3f Tcw;


    /*
     * 使用左图时间戳作为双目帧时间。
     */
    const double timestamp =
        Utility::StampToSec(
            msgLeft->header.stamp);


    /*
     * ==========================================================
     * 是否由ROS节点进行图像矫正
     * ==========================================================
     */

    if (doRectify)
    {
        cv::Mat imLeft;
        cv::Mat imRight;


        cv::remap(
            cv_ptrLeft->image,
            imLeft,
            M1l,
            M2l,
            cv::INTER_LINEAR);


        cv::remap(
            cv_ptrRight->image,
            imRight,
            M1r,
            M2r,
            cv::INTER_LINEAR);


        Tcw =
            m_SLAM->TrackStereo(
                imLeft,
                imRight,
                timestamp);
    }
    else
    {
        Tcw =
            m_SLAM->TrackStereo(
                cv_ptrLeft->image,
                cv_ptrRight->image,
                timestamp);
    }


    /*
     * TrackStereo执行结束以后：
     *
     * ORB-SLAM3内部已经更新：
     *
     * 1. Tracking State
     * 2. Camera Pose
     * 3. MapPoints
     *
     * 因此现在发布ROS2输出。
     */
    PublishSlamOutputs(
        Tcw,
        msgLeft->header);
}



void StereoSlamNode::PublishTrackedMapPoints(
    const std_msgs::msg::Header& imageHeader)
{
    /*
     * ==========================================================
     * 获取当前活动Map中的全部MapPoints
     * ==========================================================
     *
     * 使用：
     *
     * m_SLAM->GetAllMapPoints()
     *
     * 得到ORB-SLAM3当前活动Map中
     * 已经建立的全部MapPoints。
     */

    const std::vector<ORB_SLAM3::MapPoint*> map_points =
        m_SLAM->GetAllMapPoints();


    /*
     * 当前地图还没有生成MapPoint。
     */
    if (map_points.empty())
    {
        return;
    }


    /*
     * ==========================================================
     * 自动计算抽样步长
     * ==========================================================
     *
     * ROS2测试阶段单次最多发布300个点。
     */

    const std::size_t sampling_stride =
        std::max<std::size_t>(
            1,
            (
                map_points.size() +
                kMaxPublishedMapPoints -
                1
            )
            /
            kMaxPublishedMapPoints);


    /*
     * 暂存最终准备发布的XYZ地图点。
     */
    std::vector<Eigen::Vector3f> valid_points;


    valid_points.reserve(
        std::min(
            map_points.size(),
            kMaxPublishedMapPoints));


    /*
     * ==========================================================
     * MapPoint筛选
     * ==========================================================
     */

    for (
        std::size_t i = 0;
        i < map_points.size();
        i += sampling_stride)
    {
        ORB_SLAM3::MapPoint* pMP =
            map_points[i];


        /*
         * 过滤空指针。
         */
        if (pMP == nullptr)
        {
            continue;
        }


        /*
         * ORB-SLAM3已经判定失效的MapPoint不要发布。
         */
        if (pMP->isBad())
        {
            continue;
        }


        /*
         * 获取MapPoint世界坐标。
         */
        const Eigen::Vector3f world_pos =
            pMP->GetWorldPos();


        /*
         * 过滤NaN和Inf。
         */
        if (
            !std::isfinite(world_pos.x()) ||
            !std::isfinite(world_pos.y()) ||
            !std::isfinite(world_pos.z()))
        {
            continue;
        }


        /*
         * 保存有效地图点。
         */
        valid_points.push_back(
            world_pos);


        /*
         * 单次最多发布300个点。
         */
        if (
            valid_points.size() >=
            kMaxPublishedMapPoints)
        {
            break;
        }
    }


    /*
     * 经过过滤以后没有可用点。
     */
    if (valid_points.empty())
    {
        return;
    }


    /*
     * ==========================================================
     * 创建ROS2 PointCloud2
     * ==========================================================
     */

    sensor_msgs::msg::PointCloud2 cloud_msg;


    cloud_msg.header.stamp =
        imageHeader.stamp;


    cloud_msg.header.frame_id =
        kOrbMapFrame;


    /*
     * 无组织稀疏点云。
     */
    cloud_msg.height =
        1;


    /*
     * ==========================================================
     * 创建PointCloud2 XYZ字段
     * ==========================================================
     */

    sensor_msgs::PointCloud2Modifier modifier(
        cloud_msg);


    modifier.setPointCloud2FieldsByString(
        1,
        "xyz");


    modifier.resize(
        valid_points.size());


    sensor_msgs::PointCloud2Iterator<float>
        iter_x(
            cloud_msg,
            "x");


    sensor_msgs::PointCloud2Iterator<float>
        iter_y(
            cloud_msg,
            "y");


    sensor_msgs::PointCloud2Iterator<float>
        iter_z(
            cloud_msg,
            "z");


    /*
     * ==========================================================
     * Eigen XYZ -> PointCloud2
     * ==========================================================
     */

    for (
        const Eigen::Vector3f& point :
        valid_points)
    {
        *iter_x =
            static_cast<float>(
                point.x());


        *iter_y =
            static_cast<float>(
                point.y());


        *iter_z =
            static_cast<float>(
                point.z());


        ++iter_x;
        ++iter_y;
        ++iter_z;
    }


    cloud_msg.is_dense =
        true;


    /*
     * ==========================================================
     * 发布RViz稀疏地图
     * ==========================================================
     */

    map_points_pub_->publish(
        cloud_msg);
}



void StereoSlamNode::PrepareMapPointBatch()
{
    /*
     * ==========================================================
     * 获取当前活动地图全部MapPoints
     * ==========================================================
     */

    const std::vector<ORB_SLAM3::MapPoint*> map_points =
        m_SLAM->GetAllMapPoints();


    /*
     * 地图为空。
     */
    if (map_points.empty())
    {
        return;
    }


    /*
     * 当前准备发送的一批数据。
     */
    std::vector<MapPointBatchData> batch;


    batch.reserve(
        kMapPointsPerBatch);


    /*
     * 当前地图合法MapPoint总数。
     */
    std::size_t valid_count =
        0;


    /*
     * 当前还没有作为ADD同步过的
     * MapPoint总数。
     *
     * 注意：
     *
     * 这里统计的是所有等待同步的新点，
     * 不只是当前20点Batch。
     */
    std::size_t new_pending_count =
        0;


    /*
     * ==========================================================
     * 遍历当前全部MapPoints
     * ==========================================================
     */

    for (
        ORB_SLAM3::MapPoint* pMP :
        map_points)
    {
        /*
         * 空指针过滤。
         */
        if (pMP == nullptr)
        {
            continue;
        }


        /*
         * 已经失效的MapPoint过滤。
         */
        if (pMP->isBad())
        {
            continue;
        }


        /*
         * 获取世界坐标。
         */
        const Eigen::Vector3f world_pos =
            pMP->GetWorldPos();


        /*
         * NaN / Inf过滤。
         */
        if (
            !std::isfinite(world_pos.x()) ||
            !std::isfinite(world_pos.y()) ||
            !std::isfinite(world_pos.z()))
        {
            continue;
        }


        /*
         * 到这里说明该MapPoint合法。
         */
        ++valid_count;


        /*
         * 获取ORB-SLAM3 MapPoint唯一ID。
         */
        const unsigned long id =
            pMP->mnId;


        /*
         * 如果这个mnId之前已经进入过ADD Batch，
         * 当前V1阶段不重复发送。
         *
         * 下一阶段UPDATE会处理：
         *
         * 同一个mnId坐标变化的问题。
         */
        if (
            sent_map_point_ids_.find(id) !=
            sent_map_point_ids_.end())
        {
            continue;
        }


        /*
         * 该点还没有同步。
         */
        ++new_pending_count;


        /*
         * 当前Batch已经达到20点以后，
         * 不再加入本Batch。
         *
         * 但是继续遍历，
         * 用于得到完整new_pending统计。
         */
        if (
            batch.size() >=
            kMapPointsPerBatch)
        {
            continue;
        }


        /*
         * 构造当前ADD数据。
         */
        MapPointBatchData point;


        point.id =
            id;


        point.x =
            world_pos.x();


        point.y =
            world_pos.y();


        point.z =
            world_pos.z();


        batch.push_back(
            point);
    }


    /*
     * 当前没有任何新的MapPoint需要同步。
     */
    if (batch.empty())
    {
        return;
    }


    /*
     * ==========================================================
     * V1阶段模拟“发送成功”
     * ==========================================================
     *
     * 当前还没有：
     *
     * UART
     * STM32
     * LoRa
     * ACK
     *
     * 因此暂时认为：
     *
     * 进入Batch = 成功发送
     *
     * 后续真正通信时，
     * 这里必须改成收到ACK以后
     * 再标记为synced。
     */

    for (
        const MapPointBatchData& point :
        batch)
    {
        sent_map_point_ids_.insert(
            point.id);
    }


    /*
     * ==========================================================
     * Batch总体信息
     * ==========================================================
     *
     * valid：
     *
     * 当前活动地图合法MapPoint数量。
     *
     * new_pending：
     *
     * 本轮扫描开始时，
     * 尚未进入过ADD Batch的MapPoint数量。
     *
     * batch：
     *
     * 本次实际选择的点数，最大20。
     *
     * sent_total：
     *
     * 当前SLAM运行期间，
     * 已经进入过ADD Batch的不同mnId数量。
     */

    RCLCPP_INFO(
        this->get_logger(),
        "[MapBatch] valid=%zu "
        "new_pending=%zu "
        "batch=%zu "
        "sent_total=%zu",
        valid_count,
        new_pending_count,
        batch.size(),
        sent_map_point_ids_.size());


    /*
     * ==========================================================
     * 打印当前Batch每一个ADD
     * ==========================================================
     */

    for (
        const MapPointBatchData& point :
        batch)
    {
        RCLCPP_INFO(
            this->get_logger(),
            "  ADD id=%lu "
            "xyz=(%.3f, %.3f, %.3f)",
            point.id,
            point.x,
            point.y,
            point.z);
    }
}



void StereoSlamNode::PublishSlamOutputs(
    const Sophus::SE3f& Tcw,
    const std_msgs::msg::Header& imageHeader)
{
    /*
     * ==========================================================
     * 获取当前Tracking状态
     * ==========================================================
     */

    const int tracking_state =
        m_SLAM->GetTrackingState();


    /*
     * 无论SLAM当前有没有成功跟踪，
     * 都发布tracking_state。
     */
    std_msgs::msg::Int32 state_msg;


    state_msg.data =
        tracking_state;


    tracking_state_pub_->publish(
        state_msg);


    /*
     * 只在Tracking状态发生变化时打印。
     */
    if (
        tracking_state !=
        last_tracking_state_)
    {
        RCLCPP_INFO(
            this->get_logger(),
            "ORB-SLAM3 tracking state: %d (%s)",
            tracking_state,
            TrackingStateName(
                tracking_state));


        last_tracking_state_ =
            tracking_state;
    }


    /*
     * ==========================================================
     * 只在Tracking::OK时发布有效SLAM数据
     * ==========================================================
     */

    if (
        tracking_state !=
        ORB_SLAM3::Tracking::OK)
    {
        return;
    }


    /*
     * ==========================================================
     * Tcw -> Twc
     * ==========================================================
     */

    const Sophus::SE3f Twc =
        Tcw.inverse();


    /*
     * 平移。
     */
    const Eigen::Vector3f translation =
        Twc.translation();


    /*
     * 旋转。
     */
    Eigen::Quaternionf quaternion =
        Twc.unit_quaternion();


    quaternion.normalize();


    /*
     * ==========================================================
     * 位姿合法性检查
     * ==========================================================
     */

    const bool pose_is_finite =
        std::isfinite(
            translation.x()) &&
        std::isfinite(
            translation.y()) &&
        std::isfinite(
            translation.z()) &&
        std::isfinite(
            quaternion.x()) &&
        std::isfinite(
            quaternion.y()) &&
        std::isfinite(
            quaternion.z()) &&
        std::isfinite(
            quaternion.w());


    if (!pose_is_finite)
    {
        RCLCPP_WARN(
            this->get_logger(),
            "ORB-SLAM3 returned a "
            "non-finite pose");

        return;
    }


    /*
     * ==========================================================
     * 构造PoseStamped
     * ==========================================================
     */

    geometry_msgs::msg::PoseStamped pose_msg;


    pose_msg.header.stamp =
        imageHeader.stamp;


    pose_msg.header.frame_id =
        kOrbMapFrame;


    /*
     * XYZ位置。
     */
    pose_msg.pose.position.x =
        static_cast<double>(
            translation.x());


    pose_msg.pose.position.y =
        static_cast<double>(
            translation.y());


    pose_msg.pose.position.z =
        static_cast<double>(
            translation.z());


    /*
     * 四元数姿态。
     */
    pose_msg.pose.orientation.x =
        static_cast<double>(
            quaternion.x());


    pose_msg.pose.orientation.y =
        static_cast<double>(
            quaternion.y());


    pose_msg.pose.orientation.z =
        static_cast<double>(
            quaternion.z());


    pose_msg.pose.orientation.w =
        static_cast<double>(
            quaternion.w());


    /*
     * ==========================================================
     * 发布当前相机位姿
     * ==========================================================
     */

    pose_pub_->publish(
        pose_msg);


    /*
     * 已经产生有效SLAM位姿。
     */
    has_valid_pose_ =
        true;


    /*
     * ==========================================================
     * RViz MapPoints发布
     * ==========================================================
     *
     * 该路径：
     *
     * ORB-SLAM3
     * ->
     * /orbslam3/map_points
     * ->
     * RViz
     *
     * 当前约2 Hz。
     */

    ++map_points_decimation_counter_;


    if (
        (
            map_points_decimation_counter_
            %
            kMapPointsPublishStride
        )
        ==
        0)
    {
        PublishTrackedMapPoints(
            imageHeader);
    }


    /*
     * ==========================================================
     * MapPoint通信ADD Batch
     * ==========================================================
     *
     * 与RViz路径独立。
     *
     * 当前流程：
     *
     * GetAllMapPoints()
     *        ↓
     * 新mnId筛选
     *        ↓
     * 最多20点
     *        ↓
     * ADD终端打印
     *
     * 后续：
     *
     * ADD/UPDATE/DELETE
     *        ↓
     * Binary Packet
     *        ↓
     * UART
     *        ↓
     * STM32
     *        ↓
     * LoRa
     */

    ++map_batch_decimation_counter_;


    if (
        (
            map_batch_decimation_counter_
            %
            kMapBatchPublishStride
        )
        ==
        0)
    {
        PrepareMapPointBatch();
    }


    /*
     * ==========================================================
     * 更新在线Path
     * ==========================================================
     */

    ++path_decimation_counter_;


    if (
        (
            path_decimation_counter_
            %
            kPathPublishStride
        )
        !=
        0)
    {
        return;
    }


    /*
     * Path时间戳。
     */
    path_msg_.header.stamp =
        imageHeader.stamp;


    /*
     * Path和Pose、MapPoints全部统一为orb_map。
     */
    path_msg_.header.frame_id =
        kOrbMapFrame;


    /*
     * 添加当前Pose。
     */
    path_msg_.poses.push_back(
        pose_msg);


    /*
     * ==========================================================
     * 防止Path无限增长
     * ==========================================================
     */

    if (
        path_msg_.poses.size() >
        kMaxPathPoses)
    {
        path_msg_.poses.erase(
            path_msg_.poses.begin(),
            path_msg_.poses.begin() +
                500);
    }


    /*
     * 发布在线轨迹。
     */
    path_pub_->publish(
        path_msg_);
}